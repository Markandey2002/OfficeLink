{
  "realm": "office-link",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      { "name": "USER", "description": "Standard employee" },
      { "name": "ADMIN", "description": "Office administrator" }
    ]
  },
  "defaultRoles": ["USER"],
  "clients": [
    {
      "clientId": "office-link-frontend",
      "name": "Office Link Frontend",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocol": "openid-connect"
    },
    {
      "clientId": "office-link-api",
      "name": "Office Link API",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "oidc-admin",
      "email": "oidc-admin@officlink.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "OIDC",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "Admin123!",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN", "USER"]
    },
    {
      "username": "oidc-user",
      "email": "oidc-user@officlink.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "OIDC",
      "lastName": "Employee",
      "credentials": [
        {
          "type": "password",
          "value": "User123!",
          "temporary": false
        }
      ],
      "realmRoles": ["USER"]
    }
  ]
}
