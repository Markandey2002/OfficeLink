# ── Database ─────────────────────────────────────────────────────────────────
# Used by both the local backend and the Docker Compose postgres service.
DB_URL=jdbc:postgresql://localhost:5432/office_link
DB_USERNAME=postgres
DB_PASSWORD=change-me

# ── JWT (local OIDC-shaped HMAC issuer) ──────────────────────────────────────
# Use a long random secret in real deployments.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=office-link-local
JWT_EXPIRATION_MINUTES=480

# ── Keycloak / OIDC (optional) ───────────────────────────────────────────────
# Set OIDC_ENABLED=true to use Keycloak alongside the local JWT issuer.
OIDC_ENABLED=false
OIDC_ISSUER_URI=http://localhost:8081/realms/office-link
OIDC_AUDIENCE=office-link-api
OIDC_CLIENT_ID=office-link-frontend
OIDC_REDIRECT_URI=http://localhost:5173

# ── CORS / Frontend ───────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_BASE=http://localhost:8080
